# Copy to .env before running docker compose.
POSTGRES_PASSWORD=replace-with-a-long-random-password
INGEST_API_KEY=replace-with-a-long-random-ingest-key

# Public origin(s) allowed to call the API directly. The bundled nginx proxy
# calls the API server-to-server, so CORS is mainly needed when the frontend is
# hosted on another origin (for example a separate HTTPS deployment).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://100.104.179.69:5173,http://localhost:5174,http://127.0.0.1:5174,http://100.104.179.69:5174,http://localhost:8091,http://127.0.0.1:8091,http://100.104.179.69:8091

# Host interface and port for the Flask API. The Android app and a separately
# hosted frontend reach the API here; PostgreSQL remains internal to Compose.
# Bind 0.0.0.0 for LAN/Tailscale access, or set the home server's Tailscale IP.
API_BIND_ADDRESS=100.104.179.69
API_PORT=5001

# Identify this deployment to the geocoding provider with a real contact.
GEOCODING_USER_AGENT=RoadSenseVision/2.0 (public road condition map; contact: ops@example.org)

# Server-side reverse geocoding. Prefer a server key without origin
# restrictions. If the key is origin-restricted, set MAPTILER_REFERER to the
# exact allowed site origin, including any path and trailing slash.
MAPTILER_API_KEY=
MAPTILER_GEOCODING_URL=https://api.maptiler.com/geocoding
MAPTILER_REFERER=
REVERSE_GEOCODING_ENABLED=true
REVERSE_GEOCODING_ASYNC=true
REVERSE_GEOCODING_LANGUAGE=en
REVERSE_GEOCODING_MIN_INTERVAL_SECONDS=0.25
REVERSE_GEOCODING_MAX_ATTEMPTS=6
REVERSE_GEOCODING_NO_RESULT_RETRY_SECONDS=604800
REVERSE_GEOCODING_BATCH_LIMIT=100

# Browser-facing API base baked into the frontend image. Keep the same-origin
# `/api/v1` path so the bundled nginx proxies requests to the backend container;
# this works locally and on the deployed server without exposing port 5001 to
# the browser. PostgreSQL is never exposed.
VITE_API_BASE_URL=/api/v1

# Flask origin used only by Vite's local development proxy. To read deployed
# fleet data from a local Vite server, use the deployed HTTPS root, for example
# https://server.tailda589d.ts.net/roadsense.
VITE_API_PROXY_TARGET=http://127.0.0.1:5001

# Upstream root used by the bundled nginx for /api/ (do not append /api).
# The default keeps a local Compose stack self-contained. Set this to the
# deployed HTTPS root when localhost:8091 should read the same records as the
# Android fleet.
API_ORIGIN=http://backend:5000

# Vector basemap credentials baked into the public browser bundle. MapTiler is
# preferred when its key is present; otherwise Stadia Maps is used. These are
# public client-side keys, but keep them out of source control and restrict them
# to the deployed origin in the provider dashboard.
VITE_MAP_PROVIDER=
VITE_MAPTILER_API_KEY=
VITE_MAPTILER_STYLE_URL=https://api.maptiler.com/maps/streets-v2-light/style.json
VITE_STADIA_API_KEY=
VITE_STADIA_STYLE_URL=https://tiles.stadiamaps.com/styles/alidade_smooth.json

# Publish the website only on the Tailscale interface.
WEB_BIND_ADDRESS=100.104.179.69
WEB_PORT=8091
DEDUPE_RADIUS_M=25
DEDUPE_WINDOW_DAYS=45
ROAD_MATCH_RADIUS_M=30
