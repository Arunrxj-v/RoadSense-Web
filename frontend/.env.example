# Complete browser-facing API base, including the versioned `/api/v1` prefix.
# Home server over Tailscale. Browsers must be able to reach this address.
VITE_API_BASE_URL=http://100.104.179.69:5001/api/v1

# Only needed for the alternative same-origin proxy setup. When
# VITE_API_BASE_URL is `/api/v1`, set this to the Flask origin without `/api`:
# VITE_API_PROXY_TARGET=http://100.104.179.69:5001
VITE_API_PROXY_TARGET=

# Vector basemap. MapTiler is used when VITE_MAPTILER_API_KEY is present;
# otherwise the app uses Stadia Maps. Stadia permits keyless requests from
# localhost for development, but a key is required for deployed builds.
VITE_MAP_PROVIDER=
VITE_MAPTILER_API_KEY=
VITE_MAPTILER_STYLE_URL=https://api.maptiler.com/maps/streets-v2-light/style.json
VITE_STADIA_API_KEY=
VITE_STADIA_STYLE_URL=https://tiles.stadiamaps.com/styles/alidade_smooth.json

# Initial map view (Kollam, Kerala). No pothole coordinates are hardcoded.
VITE_MAP_DEFAULT_LAT=8.8932
VITE_MAP_DEFAULT_LNG=76.6141
VITE_MAP_DEFAULT_ZOOM=14

# Optional canonical site URL used for share links and Open Graph metadata.
VITE_PUBLIC_SITE_URL=
