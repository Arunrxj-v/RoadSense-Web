# Preferred: same-origin API path. Vite (development) proxies /api to the Flask
# origin below, and the bundled nginx (production) proxies /api to the backend
# container. No machine-specific address is baked into the browser bundle.
VITE_API_BASE_URL=/api/v1

# Flask or deployed HTTPS root used only by the Vite development proxy
# (without the `/api/v1` suffix). Use the deployed root to read the same
# canonical records the Android fleet uploads:
# https://server.tailda589d.ts.net/roadsense
# Keep the local Flask origin below for an isolated local database.
VITE_API_PROXY_TARGET=http://127.0.0.1:5001

# Absolute API base for deployments where the browser talks to Flask directly
# instead of through the Vite/nginx same-origin proxy, for example:
# VITE_API_BASE_URL=https://server.tailda589d.ts.net/roadsense/api/v1

# Vector basemap. MapTiler is used when VITE_MAPTILER_API_KEY is present;
# otherwise the app uses Stadia Maps. Stadia permits keyless requests from
# localhost for development, but a key is required for deployed builds.
VITE_MAP_PROVIDER=
VITE_MAPTILER_API_KEY=
VITE_MAPTILER_STYLE_URL=https://api.maptiler.com/maps/streets-v2-light/style.json
VITE_STADIA_API_KEY=
VITE_STADIA_STYLE_URL=https://tiles.stadiamaps.com/styles/alidade_smooth.json

# Initial map view (Kollam, Kerala). No pothole coordinates are hardcoded.
VITE_MAP_DEFAULT_LAT=8.8932
VITE_MAP_DEFAULT_LNG=76.6141
VITE_MAP_DEFAULT_ZOOM=14

# Optional canonical site URL used for share links and Open Graph metadata.
VITE_PUBLIC_SITE_URL=
