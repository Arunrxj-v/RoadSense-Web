# PostgreSQL + PostGIS (production)
# DATABASE_URL=postgresql://roadsense:change-me@localhost:5432/roadsense
# Local development fallback when DATABASE_URL is omitted:
# sqlite:///<backend>/instance/roadsense.db

DATABASE_URL=postgresql://roadsense:change-me@localhost:5432/roadsense

# Comma-separated public origins allowed to call the API directly from a
# browser. No entry is needed for same-origin nginx or Vite proxy requests.
# Add the real website origin when the frontend is hosted separately.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://100.104.179.69:5173,http://localhost:5174,http://127.0.0.1:5174,http://100.104.179.69:5174,http://localhost:8091,http://127.0.0.1:8091,http://100.104.179.69:8091

# Create tables/spatial indexes at boot. Set false in production and run
# `flask --app app init-db` as a deploy step.
AUTO_INIT_DB=false

# Required for POST /api/v1/internal/reports. Use a long random value.
INGEST_API_KEY=

# Server-side deduplication into canonical_potholes.
DEDUPE_RADIUS_M=25
DEDUPE_WINDOW_DAYS=45
ROAD_MATCH_RADIUS_M=30

# No-key geocoder by default. Keep requests server-side and identify your
# deployment in the User-Agent with a real contact address.
GEOCODING_PROVIDER_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=RoadSenseVision/2.0 (public road condition map; contact: ops@example.org)
GEOCODING_TIMEOUT_SECONDS=8
GEOCODING_CACHE_SECONDS=86400

# Server-side reverse geocoding for canonical pothole coordinates. Prefer a
# server key without origin restrictions. For an origin-restricted key, set
# MAPTILER_REFERER to the exact allowed site origin.
MAPTILER_API_KEY=
MAPTILER_GEOCODING_URL=https://api.maptiler.com/geocoding
MAPTILER_REFERER=
REVERSE_GEOCODING_ENABLED=true
REVERSE_GEOCODING_ASYNC=true
REVERSE_GEOCODING_LANGUAGE=en
REVERSE_GEOCODING_MIN_INTERVAL_SECONDS=0.25
REVERSE_GEOCODING_MAX_ATTEMPTS=6
REVERSE_GEOCODING_RETRY_BASE_SECONDS=900
REVERSE_GEOCODING_RETRY_MAX_SECONDS=86400
REVERSE_GEOCODING_NO_RESULT_RETRY_SECONDS=604800
REVERSE_GEOCODING_BATCH_LIMIT=100

PUBLIC_DEFAULT_LIMIT=500
PUBLIC_MAX_LIMIT=2000
PUBLIC_DETAIL_LIMIT=25

# Self-hosted contractor research. The backend enqueues jobs; the worker and
# SearXNG/Ollama services run only on the internal Compose network.
RESEARCH_ENABLED=true
RESEARCH_ADMIN_KEY=
SEARXNG_URL=http://searxng:8080
SEARXNG_ENGINES=yep
OLLAMA_URL=http://ollama:11434
RESEARCH_MODEL=qwen3:0.6b
RESEARCH_USER_AGENT=RoadSenseResearch/1.0 (public road records research; contact: ops@example.org)
RESEARCH_MAX_QUERIES=10
RESEARCH_MAX_FETCHES=5
RESEARCH_MAX_SOURCE_CHARS=3000
RESEARCH_MAX_CONTEXT_CHARS=9000
RESEARCH_MAX_HTML_BYTES=3000000
RESEARCH_MAX_PDF_BYTES=8000000
RESEARCH_MAX_DURATION_SECONDS=180
RESEARCH_SEARCH_DELAY_SECONDS=0.8
RESEARCH_FETCH_DELAY_SECONDS=1.2
RESEARCH_OLLAMA_TIMEOUT_SECONDS=120
RESEARCH_OLLAMA_NUM_CTX=4096
RESEARCH_OLLAMA_NUM_PREDICT=512
RESEARCH_CACHE_DAYS=30
RESEARCH_FAILED_RETRY_SECONDS=3600
RESEARCH_WORKER_POLL_SECONDS=5
RESEARCH_ALLOWED_PORTS=80,443
